      "colors": "{ primary, secondary } two-tone token scheme (colorblind-safe). PROPOSED — designer to finalize.",
      "tokens": "{ total:6, home:1, regular:4, destination:1 }.",
      "destination": "{ city, region, hex } fixed destination; Home->Destination run doubles the destination city's value.",
      "home_hex": "none — majors form by merging two minors (PRD 5.1)."
    },
    "minors": "Filled by C04: { number(1-30), name, region, permit, hex, power? }."
